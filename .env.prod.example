# 复制为仓库根目录 .env.prod，部署前必改密码与密钥
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=board
POSTGRES_PASSWORD=SAadmin123
POSTGRES_DB=board

SESSION_COOKIE_NAME=sid
SESSION_SECRET=qn1VoZPsuEg7Y8PrLRrxAFkrXwosdvgl15tZxbMdwV4E-M1Uy_rtoIAeOup_cH5-
SESSION_TTL_DAYS=7
# 若已配置 HTTPS，改为 true
SESSION_SECURE=false

# 网关对外端口（本机 80 已被占用时用 8080，并在 GCP 防火墙放行该端口）
HTTP_PORT=8080

# 用户访问站点的完整来源（与浏览器地址栏一致，含端口）
# 用 8080 时示例：http://34.177.94.143:8080
CORS_ORIGINS=http://34.177.94.143:8080

# 邮件中的站点链接（与浏览器访问地址一致）
APP_PUBLIC_URL=http://34.177.94.143:8080

# @ 引用留言时通知被引用者（留空 SMTP_HOST 则不发邮件）
# 示例：Gmail 需开启应用专用密码，SMTP 主机 smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=forestrain0218@gmail.com
SMTP_PASSWORD=gymd qgao qnwb hnoy
SMTP_FROM=forestrain0218@gmail.com
