# Copy to .env in repo root (used by docker-compose) and/or apps/api/.env

# PostgreSQL (docker-compose)
POSTGRES_USER=board
POSTGRES_PASSWORD=board
POSTGRES_DB=board

# API — SQLAlchemy URL (default matches compose service name `db` from apps/api container; for local uvicorn use localhost)
DATABASE_URL=postgresql+psycopg://board:board@localhost:5432/board

# Session cookie
SESSION_COOKIE_NAME=sid
# Used to sign session cookie value (HMAC); set a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=7
SESSION_SECURE=false

# CORS: comma-separated origins (required when credentials=True; use http://127.0.0.1:5173 for Vite)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
